#!/usr/bin/env bash
set -uo pipefail

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
NC=$'\033[0m'

log_info() { printf '[INFO] %s\n' "$*"; }
log_warn() { printf '[WARN] %s\n' "$*" >&2; }
log_err()  { printf '[ERROR] %s\n' "$*" >&2; }

CONFIG_FILE="/etc/fscrypt-opener.conf"
IMG_PATH=""
MOUNT_POINT=""
MAPPER_NAME="secure_img_api"

# --- Cleanup & Trap ---
cleanup() {
    local exit_code=$?
    if [[ $exit_code -ne 0 ]]; then
        log_warn "Script finished with status code: $exit_code"
    fi
    exit "$exit_code"
}

trap cleanup EXIT INT TERM

# 1. Create standard config if not present (No passwords!)
create_default_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        log_info "Creating default configuration at $CONFIG_FILE..."
        cat << 'EOF' > "$CONFIG_FILE"
# Standard configuration for fscrypt-opener (No passwords allowed here)
IMG_PATH=""
MOUNT_POINT=""
# Example Auto-lock configuration per folder:
# AUTOLOCK_myfolder="10"
EOF
    fi
}

# 2. Safely load configuration (Excluding passwords)
load_config() {
    local cfg="$1"
    if [[ -f "$cfg" ]]; then
        log_info "Reading configuration securely from: $cfg"
        while IFS='=' read -r key value; do
            [[ "$key" =~ ^[[:space:]]*# ]] && continue
            [[ -z "$key" ]] && continue
            
            key=$(echo "$key" | xargs)
            value=$(echo "$value" | xargs | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//")
            
            case "$key" in
                IMG_PATH|MOUNT_POINT|AUTOLOCK_*)
                    printf -v "$key" '%s' "$value" 2>/dev/null || true
                    ;;
            esac
        done < "$cfg"
    fi
}

# 3. Parse arguments via getopts
parse_args() {
    while getopts ":c:i:m:h" opt; do
        case "$opt" in
            c) CONFIG_FILE="$OPTARG" ;;
            i) IMG_PATH="$OPTARG" ;;
            m) MOUNT_POINT="$OPTARG" ;;
            h)
                echo "Usage: $0 [-c config] [-i image] [-m mountpoint]"
                exit 0
                ;;
            \?)
                log_err "Unrecognized option: -$OPTARG"
                return 1
                ;;
            :)
                log_err "Option -$OPTARG requires an argument."
                return 1
                ;;
        esac
    done
    return 0
}

# 4. Check system requirements
check_system_requirements() {
    if [[ $EUID -ne 0 ]]; then
        log_err "This script must be executed with root privileges."
        return 1
    fi

    local required_commands=(cryptsetup mount umount fscrypt realpath modprobe lsmod mountpoint findmnt)
    for cmd in "${required_commands[@]}"; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            log_err "Missing required command: $cmd"
            return 1
        fi
    done

    local required_modules=(xts aes_generic ext4 dm_crypt)
    for mod in "${required_modules[@]}"; do
        if modprobe -n "$mod" >/dev/null 2>&1 && ! lsmod | grep -q "^$mod\b"; then
            log_info "Loading kernel module: $mod"
            modprobe "$mod" || { log_err "Failed to load module: $mod"; return 1; }
        fi
    done
    return 0
}

# 5. Path validation
resolve_paths() {
    if [[ -n "$IMG_PATH" ]] && { [[ ! -f "$IMG_PATH" ]] || [[ ! -r "$IMG_PATH" ]]; }; then
        log_warn "Configured image path is invalid or unreadable: $IMG_PATH"
        IMG_PATH=""
    fi

    if [[ -z "$IMG_PATH" ]]; then
        read -r -p "Path to LUKS image (e.g., /secure/storage.img): " IMG_PATH
    fi

    if [[ -z "$IMG_PATH" || ! -f "$IMG_PATH" ]]; then
        log_err "No valid image specified."
        return 1
    fi

    IMG_PATH=$(realpath -m -- "$IMG_PATH")
    return 0
}

# --- API Functions (Daemon & API Ready) ---
api_open_luks() {
    if cryptsetup status "$MAPPER_NAME" >/dev/null 2>&1; then
        log_info "LUKS volume '$MAPPER_NAME' is already open and active."
        return 0
    else
        log_info "Opening LUKS volume: $IMG_PATH"
        cryptsetup luksOpen "$IMG_PATH" "$MAPPER_NAME" || return 1
    fi
}

api_mount_fs() {
    if ! mountpoint -q -- "$MOUNT_POINT"; then
        log_info "Mounting filesystem to $MOUNT_POINT"
        mkdir -p -- "$MOUNT_POINT"
        mount "/dev/mapper/$MAPPER_NAME" "$MOUNT_POINT" || return 1
    else
        log_info "Filesystem is already mounted at $MOUNT_POINT."
    fi
    return 0
}

is_fscrypt_encrypted_dir() {
    local target_dir="$1"
    if fscrypt status "$target_dir" 2>/dev/null | grep -qiE "encrypted:\s*yes|policy:"; then
        return 0
    fi
    return 1
}

api_decrypt_fscrypt() {
    local target_dir="$1"
    local rel_path="$2"
    
    log_info "Unlocking fscrypt directory interactively: $target_dir"
    # fscrypt handles its own secure password prompt natively per directory
    fscrypt unlock "$target_dir" || return 1
}

api_lock_fscrypt() {
    local target_dir="$1"
    log_info "Locking fscrypt directory automatically: $target_dir"
    fscrypt lock "$target_dir"
}

# --- STEP 2: Process fscrypt directories ---
process_fscrypt_directories() {
    if [[ ! -d "$MOUNT_POINT" ]]; then
        log_err "Mount point is invalid: $MOUNT_POINT"
        return 1
    fi

    log_info "Scanning subdirectories in $MOUNT_POINT..."
    local target_dirs=()
    while IFS= read -r -d '' dir; do
        local rel_path="${dir#$MOUNT_POINT/}"
        if [[ "$rel_path" == "lost+found" || "$rel_path" == ".fscrypt" || "$rel_path" =~ ^\. ]] || [[ -z "$rel_path" ]]; then
            continue
        fi
        target_dirs+=("$dir")
    done < <(find "$MOUNT_POINT" -mindepth 1 -maxdepth 1 -type d -print0)

    for dir in "${target_dirs[@]}"; do
        local rel_path="${dir#$MOUNT_POINT/}"
        local safe_var_name="${rel_path//[^a-zA-Z0-9_]/_}"

        if is_fscrypt_encrypted_dir "$dir"; then
            log_info "Found valid fscrypt directory: $rel_path"
            api_decrypt_fscrypt "$dir" "$rel_path" || {
                log_warn "Could not unlock '$rel_path'. Skipping this folder."
                continue
            }
        else
            log_info "Folder '$rel_path' has no fscrypt encryption policy. Skipping."
            continue
        fi

        # Auto-Lock handling per folder
        local config_var_name="AUTOLOCK_${safe_var_name}"
        local current_auto_lock="${!config_var_name:-}"
        local auto_lock_min=""

        if [[ -n "$current_auto_lock" ]]; then
            log_info "Auto-lock loaded from config for '$rel_path': $current_auto_lock minutes."
            auto_lock_min="$current_auto_lock"
        else
            read -r -p "Auto-lock for '$rel_path' after X minutes (0 or empty for no auto-lock): " auto_lock_min
        fi

        if [[ "$auto_lock_min" =~ ^[0-9]+$ ]] && (( auto_lock_min > 0 )); then
            (
                sleep "$(( auto_lock_min * 60 ))"
                api_lock_fscrypt "$dir"
            ) &
            log_info "Auto-timer for '$rel_path' started: locking in $auto_lock_min minutes."

            if [[ -z "$current_auto_lock" ]]; then
                read -r -p "Save this auto-lock value ($auto_lock_min min.) permanently in the config? [y/N]: " save_cfg
                if [[ "$save_cfg" =~ ^[Yy]$ ]]; then
                    echo "AUTOLOCK_${safe_var_name}='$auto_lock_min'" >> "$CONFIG_FILE"
                    log_info "Saved auto-lock setting to $CONFIG_FILE."
                fi
            fi
        else
            log_info "No auto-lock configured for '$rel_path' (remains open)."
        fi
    done
    return 0
}

# 6. Main Logic (Procedural Flow)
main() {
    parse_args "$@" || return 1
    create_default_config
    load_config "$CONFIG_FILE"
    check_system_requirements || return 1
    resolve_paths || return 1

    # Step 1: Open LUKS & check mount point reuse
    api_open_luks || { log_err "Failed to open LUKS container."; return 1; }

    local existing_mount=""
    existing_mount=$(findmnt -n -o TARGET "/dev/mapper/$MAPPER_NAME" 2>/dev/null || true)

    if [[ -n "$existing_mount" ]]; then
        log_info "LUKS mapper is already mounted at: $existing_mount"
        echo "1) Reuse existing mount point ($existing_mount)"
        echo "2) Specify a new mount point"
        read -r -p "Choose option [1/2] (default 1): " mount_choice
        mount_choice="${mount_choice:-1}"

        if [[ "$mount_choice" == "2" ]]; then
            read -r -p "New mount point: " MOUNT_POINT
            if [[ -z "$MOUNT_POINT" ]]; then
                log_err "No mount point provided."
                return 1
            fi
            MOUNT_POINT=$(realpath -m -- "$MOUNT_POINT")
            api_mount_fs || { log_err "Failed to mount filesystem."; return 1; }
        else
            MOUNT_POINT="$existing_mount"
            log_info "Reusing existing mount point. Jumping directly to Step 2 (fscrypt processing)..."
        fi
    else
        if [[ -z "$MOUNT_POINT" ]]; then
            read -r -p "Mount point (e.g., /mnt/secure): " MOUNT_POINT
        fi
        if [[ -z "$MOUNT_POINT" ]]; then
            log_err "No mount point provided."
            return 1
        fi
        MOUNT_POINT=$(realpath -m -- "$MOUNT_POINT")
        api_mount_fs || { log_err "Failed to mount filesystem."; return 1; }
    fi

    # Step 2: Process fscrypt directories
    process_fscrypt_directories || { log_warn "Encountered issues while processing fscrypt folders."; }

    log_info "Setup complete. LUKS volume and target folders remain active."
    return 0
}

main "$@"

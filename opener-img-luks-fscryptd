set -uo pipefail

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
NC=$'\033[0m'

log_info() { printf '[INFO] %s\n' "$*"; }
log_warn() { printf '[WARN] %s\n' "$*" >&2; }
log_err()  { printf '[ERROR] %s\n' "$*" >&2; }

CONFIG_FILE="/etc/fscrypt-opener.conf"
RUN_DIR="/run/fscrypt-opener"
IMG_PATH=""
MOUNT_POINT=""
MAPPER_NAME="secure_img_api"

cleanup() {
    local exit_code=$?
    if (( exit_code != 0 )); then
        log_warn "Script finished with status code: $exit_code"
    fi
    exit "$exit_code"
}

trap cleanup EXIT INT TERM

create_default_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        log_info "Creating default configuration at $CONFIG_FILE..."
        cat << 'EOF' > "$CONFIG_FILE"
IMG_PATH=""
MOUNT_POINT=""
DEFAULT_AUTOLOCK="10"
EOF
    fi
    mkdir -p "$RUN_DIR" 2>/dev/null || true
    chmod 755 "$RUN_DIR" 2>/dev/null || true
}

load_config() {
    local cfg="$1"
    if [[ -f "$cfg" ]]; then
        while IFS='=' read -r key value; do
            [[ "$key" =~ ^[[:space:]]*# ]] && continue
            [[ -z "$key" ]] && continue
            
            key=$(echo "$key" | xargs)
            value=$(echo "$value" | xargs | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//")
            
            case "$key" in
                IMG_PATH|MOUNT_POINT|DEFAULT_AUTOLOCK|AUTOLOCK_*)
                    printf -v "$key" '%s' "$value" 2>/dev/null || true
                    ;;
            esac
        done < "$cfg"
    fi
}

check_system_requirements() {
    if (( EUID != 0 )); then
        log_err "This script must be executed with root privileges."
        return 1
    fi

    local required_commands=(cryptsetup mount umount fscrypt realpath mountpoint findmnt)
    for cmd in "${required_commands[@]}"; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            log_err "Missing required command: $cmd"
            return 1
        fi
    done
    return 0
}

resolve_paths() {
    if [[ -n "$IMG_PATH" ]] && { [[ ! -f "$IMG_PATH" ]] || [[ ! -r "$IMG_PATH" ]]; }; then
        log_warn "Configured image path is invalid or unreadable: $IMG_PATH"
        IMG_PATH=""
    fi

    if [[ -z "$IMG_PATH" ]]; then
        log_err "No valid image specified in config."
        return 1
    fi

    IMG_PATH=$(realpath -m -- "$IMG_PATH")
    [[ -z "$MOUNT_POINT" ]] && MOUNT_POINT="/mnt/secure"
    MOUNT_POINT=$(realpath -m -- "$MOUNT_POINT")
    return 0
}

api_open_luks() {
    if cryptsetup status "$MAPPER_NAME" >/dev/null 2>&1; then
        return 0
    else
        if [[ -t 0 ]]; then
            cryptsetup luksOpen "$IMG_PATH" "$MAPPER_NAME" || return 1
        else
            cryptsetup luksOpen --key-file - "$IMG_PATH" "$MAPPER_NAME" || return 1
        fi
    fi
}

api_mount_fs() {
    if ! mountpoint -q -- "$MOUNT_POINT"; then
        mkdir -p -- "$MOUNT_POINT"
        mount "/dev/mapper/$MAPPER_NAME" "$MOUNT_POINT" || return 1
    fi
    return 0
}

check_fscrypt_status() {
    local target_dir="$1"
    if [[ -d "$target_dir/.fscrypt" ]]; then
        return 0
    fi
    local status_out
    status_out=$(fscrypt status "$target_dir" 2>&1 || true)
    echo "$status_out" | grep -qiE "encrypted:[[:space:]]*yes|policy:|not unlocked"
}

# --- Spezielle Funktion 1: Interaktiver Modus (für das Terminal) ---
fscrypt_unlock_interactive() {
    local target_dir="$1"
    local rel_path="$2"
    log_info "Unlocking fscrypt directory interactively: $target_dir"

    # Führt fscrypt direkt aus; das Terminal übernimmt die Interaktion,
    # bricht aber bei Fehleingabe kontrolliert ab ohne Endlosschleife im Skript.
    if ! fscrypt unlock "$target_dir"; then
        log_err "Failed to unlock fscrypt directory: $rel_path"
        return 1
    fi
    return 0
}

# --- Spezielle Funktion 2: Nicht-interaktiver Modus (für API / GUI / pkexec) ---
fscrypt_unlock_noninteractive() {
    local target_dir="$1"
    local rel_path="$2"
    log_info "Unlocking fscrypt directory non-interactively: $target_dir"

    # Nutzt --quiet, um jegliche Endlosschleifen im Hintergrund zu blockieren
    if ! fscrypt unlock --quiet "$target_dir"; then
        log_err "Failed to unlock fscrypt directory in non-interactive mode: $rel_path"
        return 1
    fi
    return 0
}

api_decrypt_fscrypt() {
    local target_dir="$1"
    local rel_path="$2"

    if [[ -t 0 ]]; then
        fscrypt_unlock_interactive "$target_dir" "$rel_path" || return 1
    else
        fscrypt_unlock_noninteractive "$target_dir" "$rel_path" || return 1
    fi

    local safe_var_name="${rel_path//[^a-zA-Z0-9_]/_}"
    local config_var_name="AUTOLOCK_${safe_var_name}"
    local auto_lock_min="${!config_var_name:-${DEFAULT_AUTOLOCK:-10}}"

    if [[ "$auto_lock_min" =~ ^[0-9]+$ ]] && (( auto_lock_min > 0 )); then
        local expire_epoch=$(( $(date +%s) + (auto_lock_min * 60) ))
        echo "$expire_epoch" > "$RUN_DIR/timer_${safe_var_name}"
        
        (
            sleep "$(( auto_lock_min * 60 ))"
            fscrypt lock "$target_dir"
            rm -f "$RUN_DIR/timer_${safe_var_name}"
        ) &
        log_info "Auto-timer for '$rel_path' started: locking in $auto_lock_min minutes."
    fi
    return 0
}

api_lock_fscrypt() {
    local target_dir="$1"
    local rel_path="$2"
    local safe_name="${rel_path//[^a-zA-Z0-9_]/_}"
    fscrypt lock "$target_dir"
    rm -f "$RUN_DIR/timer_${safe_name}"
}

api_output_json_status() {
    local luks_locked=true
    local mount_pt="N/A"
    
    if cryptsetup status "$MAPPER_NAME" >/dev/null 2>&1; then
        luks_locked=false
        mount_pt=$(findmnt -n -o TARGET "/dev/mapper/$MAPPER_NAME" 2>/dev/null || echo "not_mounted")
    fi
    
    printf '{\n'
    printf '  "luks_locked": %s,\n' "$luks_locked"
    printf '  "mount_point": "%s",\n' "$mount_pt"
    printf '  "fscrypt_folders": [\n'
    
    if [[ "$luks_locked" == "false" && "$mount_pt" != "not_mounted" && -d "$mount_pt" ]]; then
        local first=true
        while IFS= read -r -d '' dir; do
            local rel_path="${dir#$mount_pt/}"
            [[ "$rel_path" == "lost+found" || "$rel_path" =~ ^\. ]] && continue
            
            if check_fscrypt_status "$dir"; then
                local locked=true
                if ls "$dir" >/dev/null 2>&1; then locked=false; fi
                
                local rem_sec=-1
                local safe_name="${rel_path//[^a-zA-Z0-9_]/_}"
                if [[ "$locked" == "false" && -f "$RUN_DIR/timer_${safe_name}" ]]; then
                    local expire_epoch
                    expire_epoch=$(cat "$RUN_DIR/timer_${safe_name}" 2>/dev/null || echo "0")
                    rem_sec=$(( expire_epoch - $(date +%s) ))
                    (( rem_sec < 0 )) && rem_sec=0
                elif [[ "$locked" == "false" ]]; then
                    rem_sec=99999
                fi

                [[ "$first" == "true" ]] || printf ',\n'
                printf '    {\n'
                printf '      "name": "%s",\n' "$rel_path"
                printf '      "locked": %s,\n' "$locked"
                printf '      "remaining_time_sec": %d\n' "$rem_sec"
                printf '    }'
                first=false
            fi
        done < <(find "$mount_pt" -mindepth 1 -maxdepth 1 -type d -print0)
    fi
    
    printf '\n  ]\n'
    printf '}\n'
}

api_save_setting() {
    local key="$1"
    local value="$2"
    if [[ -n "$key" && -n "$value" ]]; then
        echo "${key}='${value}'" >> "$CONFIG_FILE"
        log_info "Saved setting $key=$value"
    fi
}

api_close_all() {
    load_config "$CONFIG_FILE"
    if [[ -n "$MOUNT_POINT" ]] && mountpoint -q -- "$MOUNT_POINT"; then
        umount "$MOUNT_POINT" || true
    fi
    if cryptsetup status "$MAPPER_NAME" >/dev/null 2>&1; then
        cryptsetup luksClose "$MAPPER_NAME" || true
    fi
    rm -f "$RUN_DIR"/timer_* 2>/dev/null || true
    log_info "Container closed successfully."
}

handle_api() {
    create_default_config
    load_config "$CONFIG_FILE"

    case "${1:-}" in
        api_status)
            api_output_json_status
            exit 0
            ;;
        api_open)
            check_system_requirements || exit 1
            resolve_paths || exit 1
            api_open_luks || exit 1
            api_mount_fs || exit 1
            exit 0
            ;;
        api_close)
            check_system_requirements || exit 1
            api_close_all
            exit 0
            ;;
        api_unlock_folder)
            check_system_requirements || exit 1
            load_config "$CONFIG_FILE"
            local target_dir="${MOUNT_POINT:-/mnt/secure}/$2"
            [[ -d "$target_dir" ]] && api_decrypt_fscrypt "$target_dir" "$2"
            exit 0
            ;;
        api_lock_folder)
            check_system_requirements || exit 1
            load_config "$CONFIG_FILE"
            local target_dir="${MOUNT_POINT:-/mnt/secure}/$2"
            [[ -d "$target_dir" ]] && api_lock_fscrypt "$target_dir" "$2"
            exit 0
            ;;
        api_save_setting)
            api_save_setting "$2" "$3"
            exit 0
            ;;
        daemon)
            check_system_requirements || exit 1
            log_info "Daemon running in background..."
            while true; do sleep 30; done
            exit 0
            ;;
        -h|--help)
            echo "Usage: $0 [API_COMMAND] [ARGS...]"
            exit 0
            ;;
        *)
            return 1
            ;;
    esac
}

run_interactive_cli() {
    create_default_config
    load_config "$CONFIG_FILE"

    while getopts ":c:i:m:h" opt; do
        case "$opt" in
            c) CONFIG_FILE="$OPTARG" ;;
            i) IMG_PATH="$OPTARG" ;;
            m) MOUNT_POINT="$OPTARG" ;;
            h) exit 0 ;;
            \?) return 1 ;;
            :) return 1 ;;
        esac
    done

    check_system_requirements || return 1
    
    if [[ -z "$IMG_PATH" ]]; then
        read -r -p "Path to LUKS image: " IMG_PATH
    fi
    IMG_PATH=$(realpath -m -- "$IMG_PATH")

    api_open_luks || { log_err "Failed to open LUKS container."; return 1; }

    if [[ -z "$MOUNT_POINT" ]]; then
        read -r -p "Mount point (e.g., /mnt/secure): " MOUNT_POINT
    fi
    MOUNT_POINT=$(realpath -m -- "$MOUNT_POINT")
    
    api_mount_fs || { log_err "Failed to mount filesystem."; return 1; }

    if [[ -d "$MOUNT_POINT" ]]; then
        while IFS= read -r -d '' dir; do
            local rel_path="${dir#$MOUNT_POINT/}"
            [[ "$rel_path" == "lost+found" || "$rel_path" == ".fscrypt" || "$rel_path" =~ ^\. ]] && continue
            if check_fscrypt_status "$dir"; then
                log_info "Detected fscrypt directory: $rel_path"
                api_decrypt_fscrypt "$dir" "$rel_path" || true
            fi
        done < <(find "$MOUNT_POINT" -mindepth 1 -maxdepth 1 -type d -print0)
    fi

    log_info "Interactive CLI setup complete."
    return 0
}

main() {
    if handle_api "${1:-}" "$@"; then
        exit 0
    else
        run_interactive_cli "$@"
    fi
}

main "$@"

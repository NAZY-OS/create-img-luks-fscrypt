#!/usr/bin/env bash
set -uo pipefail

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
NC=$'\033[0m'

log_info() { printf '[INFO] %s\n' "$*"; }
log_warn() { printf '[WARN] %s\n' "$*" >&2; }
log_err()  { printf '[ERROR] %s\n' "$*" >&2; }

CONFIG_FILE="/etc/fscrypt-opener.conf"
RUN_DIR="/run/fscrypt-opener"
IMG_PATH=""
MOUNT_POINT=""
MAPPER_NAME="secure_img_api"

# --- Cleanup & Trap ---
cleanup() {
    local exit_code=$?
    if [[ $exit_code -ne 0 ]]; then
        log_warn "Script finished with status code: $exit_code"
    fi
    exit "$exit_code"
}

trap cleanup EXIT INT TERM

create_default_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        log_info "Creating default configuration at $CONFIG_FILE..."
        cat << 'EOF' > "$CONFIG_FILE"
# Standard configuration for fscrypt-opener (No passwords)
IMG_PATH=""
MOUNT_POINT=""
DEFAULT_AUTOLOCK="10"
EOF
    fi
    mkdir -p "$RUN_DIR"
    chmod 755 "$RUN_DIR"
}

load_config() {
    local cfg="$1"
    if [[ -f "$cfg" ]]; then
        while IFS='=' read -r key value; do
            [[ "$key" =~ ^[[:space:]]*# ]] && continue
            [[ -z "$key" ]] && continue
            key=$(echo "$key" | xargs)
            value=$(echo "$value" | xargs | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//")
            case "$key" in
                IMG_PATH|MOUNT_POINT|DEFAULT_AUTOLOCK|AUTOLOCK_*)
                    printf -v "$key" '%s' "$value" 2>/dev/null || true
                    ;;
            esac
        done < "$cfg"
    fi
}

check_system_requirements() {
    if [[ $EUID -ne 0 ]]; then
        log_err "This script must be executed with root privileges."
        return 1
    fi
    local required_commands=(cryptsetup mount umount fscrypt realpath mountpoint findmnt)
    for cmd in "${required_commands[@]}"; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            log_err "Missing required command: $cmd"
            return 1
        fi
    done
    return 0
}

resolve_paths() {
    if [[ -z "$IMG_PATH" || ! -f "$IMG_PATH" ]]; then
        log_err "No valid image specified in config."
        return 1
    fi
    IMG_PATH=$(realpath -m -- "$IMG_PATH")
    return 0
}

api_open_luks() {
    if cryptsetup status "$MAPPER_NAME" >/dev/null 2>&1; then
        return 0
    else
        cryptsetup luksOpen "$IMG_PATH" "$MAPPER_NAME" || return 1
    fi
}

api_mount_fs() {
    if ! mountpoint -q -- "$MOUNT_POINT"; then
        mkdir -p -- "$MOUNT_POINT"
        mount "/dev/mapper/$MAPPER_NAME" "$MOUNT_POINT" || return 1
    fi
    return 0
}

check_fscrypt_status() {
    local target_dir="$1"
    if [[ -d "$target_dir/.fscrypt" ]]; then
        return 0
    fi
    local status_out
    status_out=$(fscrypt status "$target_dir" 2>&1 || true)
    echo "$status_out" | grep -qiE "encrypted:\s*yes|policy:|not unlocked"
}

# GUI-gestütztes Entschlüsseln via zenity/kdialog oder Standard-Passphrase
api_decrypt_fscrypt() {
    local target_dir="$1"
    local rel_path="$2"
    
    # Passwort über grafischen Dialog abfragen falls möglich
    local passphrase=""
    if command -v zenity >/dev/null 2>&1; then
        passphrase=$(zenity --password --title="Fscrypt Unlock" --text="Enter passphrase for $rel_path:" 2>/dev/null || true)
    elif command -v kdialog >/dev/null 2>&1; then
        passphrase=$(kdialog --password "Enter passphrase for $rel_path:" 2>/dev/null || true)
    fi

    if [[ -n "$passphrase" ]]; then
        echo "$passphrase" | fscrypt unlock "$target_dir" --unlock-with-passphrase || return 1
    else
        fscrypt unlock "$target_dir" || return 1
    fi

    # Auto-Lock Timer starten und Endzeitpunkt in /run/fscrypt-opener/ hinterlegen
    local safe_name="${rel_path//[^a-zA-Z0-9_]/_}"
    local config_var="AUTOLOCK_${safe_name}"
    local lock_min="${!config_var:-${DEFAULT_AUTOLOCK:-10}}"

    if [[ "$lock_min" =~ ^[0-9]+$ ]] && (( lock_min > 0 )); then
        local expire_epoch=$(( $(date +%s) + (lock_min * 60) ))
        echo "$expire_epoch" > "$RUN_DIR/timer_${safe_name}"
        
        (
            sleep "$(( lock_min * 60 ))"
            fscrypt lock "$target_dir"
            rm -f "$RUN_DIR/timer_${safe_name}"
        ) &
    fi
}

api_lock_fscrypt() {
    local target_dir="$1"
    local rel_path="$2"
    local safe_name="${rel_path//[^a-zA-Z0-9_]/_}"
    fscrypt lock "$target_dir"
    rm -f "$RUN_DIR/timer_${safe_name}"
}

api_output_json_status() {
    local luks_locked=true
    local mount_pt="N/A"
    
    if cryptsetup status "$MAPPER_NAME" >/dev/null 2>&1; then
        luks_locked=false
        mount_pt=$(findmnt -n -o TARGET "/dev/mapper/$MAPPER_NAME" 2>/dev/null || echo "not_mounted")
    fi
    
    printf '{\n'
    printf '  "luks_locked": %s,\n' "$luks_locked"
    printf '  "mount_point": "%s",\n' "$mount_pt"
    printf '  "fscrypt_folders": [\n'
    
    if [[ "$luks_locked" == "false" && "$mount_pt" != "not_mounted" && -d "$mount_pt" ]]; then
        local first=true
        while IFS= read -r -d '' dir; do
            local rel_path="${dir#$mount_pt/}"
            [[ "$rel_path" == "lost+found" || "$rel_path" =~ ^\. ]] && continue
            
            if check_fscrypt_status "$dir"; then
                local locked=true
                if ls "$dir" >/dev/null 2>&1; then locked=false; fi
                
                local rem_sec=-1
                local safe_name="${rel_path//[^a-zA-Z0-9_]/_}"
                if [[ "$locked" == "false" && -f "$RUN_DIR/timer_${safe_name}" ]]; then
                    local expire_epoch
                    expire_epoch=$(cat "$RUN_DIR/timer_${safe_name}")
                    local current_epoch
                    current_epoch=$(date +%s)
                    rem_sec=$(( expire_epoch - current_epoch ))
                    (( rem_sec < 0 )) && rem_sec=0
                elif [[ "$locked" == "false" ]]; then
                    rem_sec=99999
                fi

                [[ "$first" == "true" ]] || printf ',\n'
                printf '    {\n'
                printf '      "name": "%s",\n' "$rel_path"
                printf '      "locked": %s,\n' "$locked"
                printf '      "remaining_time_sec": %d\n' "$rem_sec"
                printf '    }'
                first=false
            fi
        done < <(find "$mount_pt" -mindepth 1 -maxdepth 1 -type d -print0)
    fi
    
    printf '\n  ]\n'
    printf '}\n'
}

api_save_setting() {
    local key="$1"
    local value="$2"
    if [[ -n "$key" && -n "$value" ]]; then
        echo "${key}='${value}'" >> "$CONFIG_FILE"
        log_info "Saved setting $key=$value"
    fi
}

api_close_all() {
    load_config "$CONFIG_FILE"
    if [[ -n "$MOUNT_POINT" ]] && mountpoint -q -- "$MOUNT_POINT"; then
        umount "$MOUNT_POINT" || true
    fi
    if cryptsetup status "$MAPPER_NAME" >/dev/null 2>&1; then
        cryptsetup luksClose "$MAPPER_NAME" || true
    fi
    rm -f "$RUN_DIR"/timer_*
    log_info "Container closed successfully."
}

main() {
    create_default_config
    load_config "$CONFIG_FILE"

    case "${1:-}" in
        api_status)
            api_output_json_status
            exit 0
            ;;
        api_open)
            check_system_requirements || exit 1
            resolve_paths || exit 1
            api_open_luks || exit 1
            [[ -z "$MOUNT_POINT" ]] && MOUNT_POINT="/mnt/secure"
            api_mount_fs || exit 1
            # Scan & Auto-unlock directories if configured
            while IFS= read -r -d '' dir; do
                local rel_path="${dir#$MOUNT_POINT/}"
                [[ "$rel_path" == "lost+found" || "$rel_path" =~ ^\. ]] && continue
                if check_fscrypt_status "$dir"; then
                    api_decrypt_fscrypt "$dir" "$rel_path" || true
                fi
            done < <(find "$MOUNT_POINT" -mindepth 1 -maxdepth 1 -type d -print0)
            exit 0
            ;;
        api_close)
            check_system_requirements || exit 1
            api_close_all
            exit 0
            ;;
        api_unlock_folder)
            check_system_requirements || exit 1
            load_config "$CONFIG_FILE"
            local target_dir="$MOUNT_POINT/$2"
            if [[ -d "$target_dir" ]]; then
                api_decrypt_fscrypt "$target_dir" "$2"
            fi
            exit 0
            ;;
        api_lock_folder)
            check_system_requirements || exit 1
            load_config "$CONFIG_FILE"
            local target_dir="$MOUNT_POINT/$2"
            if [[ -d "$target_dir" ]]; then
                api_lock_fscrypt "$target_dir" "$2"
            fi
            exit 0
            ;;
        api_save_setting)
            api_save_setting "$2" "$3"
            exit 0
            ;;
    esac
}

main "$@"
